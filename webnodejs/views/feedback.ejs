<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách phản hồi</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <%- include('partials/sidebar') %>

    <div class="main-content">
        <header>
            <div class="header-top">
                <h2>Danh sách Phản hồi</h2>
            </div>
            <div class="header-actions">
                <input class="input-field"  type="text" id="search-bar" placeholder="Tìm kiếm phản hồi..." oninput="searchFeedback()">
                <div class="button-group">
                    <select id="rating-filter" class="filter">
                        <option value="">Chọn điểm đánh giá</option>
                    </select>
                    <input class="input-field"  type="text" id="id-search" placeholder="Nhập Mã Khách hàng">
                    <button class="button" onclick="searchFeedbackByCustomerId()">Lọc theo Mã Khách hàng</button>            
                    <button class="button" onclick="refreshFeedbackTable()">Làm mới</button>
                </div>
            </div>
        </header>

        <section class="feedback-table">
            <table id="feedback-table">
                <thead>
                    <tr>    
                        <th data-column="Feedback_ID" onclick="sortTable('Feedback_ID')">Feedback ID</th>
                        <th data-column="Customer_ID" onclick="sortTable('Customer_ID')">Mã KH</th>
                        <th data-column="Order_ID" onclick="sortTable('Order_ID')">Mã Đơn Hàng</th>
                        <th data-column="Rating" onclick="sortTable('Rating')">Đánh giá</th>
                        <th data-column="Comments" onclick="sortTable('Comments')">Nội dung</th>
                    </tr>
                </thead>                
                <tbody id="feedback-data">
                </tbody>
            </table>
        </section>
    </div>

    <script src="/js/feedback.js"></script>
</body>
</html>
